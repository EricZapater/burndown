{
  "expo": {
    "name": "Burndown",
    "slug": "burndown",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "burndown",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eric.zapater.burndown"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.eric.zapater.burndown",
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Necessitem la càmera per escanejar els teus àpats."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "72dd26a6-b892-4c3a-82d5-41b82da96626"
      }
    }
  }
}
